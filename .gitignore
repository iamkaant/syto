__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/
.DS_Store

# vendored browser runtime (large, fetched by tools/fetch_web_deps.py)
web/vendor/

# compiled handbook data is a build product of data-src/
core/hitpicking/data/handbook.json

# local scratch
scratch/
*.log

# vendored at build time by tools/vendor_core.py
chimerax/src/_vendor/
chimerax/dist/
chimerax/build/

# fetched QM scans: large, reproducible with tools/fetch_qm_torsions.py
data-src/external/qm_torsions/raw/

# built from core/ and ui/ by tools/build_web_core.py
web/ui/
web/vendor/hitpicking.zip

# headless-browser profiles from the test harnesses
.chrome-*/
web/build.js

# Research data, not source - anywhere in the tree, not just the top.
#
# Receptors, poses, saved sessions and saved parties are unpublished
# work: which compounds were looked at and what was thought of them.
# Structure files were committed early once already and had to be cut
# out of the history, which rewrote every commit. This is the guard that
# stops it happening again, so it is deliberately wide.
#
# Nothing of this kind is tracked: the test fixtures live outside the
# checkout and are found through $HITPICK_SAMPLES (tools/samples.py). If
# a small fixture ever does belong in git, add it with `git add -f`.
*.mol2
*.pdb
*.ent
*.sdf
*.sd
*.mol
*.cif
*.mmcif
*.mae
*.maegz
*.db2
*.db2.gz
*.cxs
*.cxc
party*.json

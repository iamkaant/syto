  "licence_url": "https://github.com/openforcefield/qca-dataset-submission/blob/master/LICENSE",
  "non_qm_scans_excluded": 940,
  "server": "https://api.qcarchive.molssi.org",
  "server_licence_note": "The public QCArchive server itself states no site-wide data licence; only OpenFF-submitted datasets are used by default.",
  "source": "MolSSI QCArchive (public server)",
  "specification": "default",
  "submitter": "Open Force Field Initiative",
  "superseded_datasets_excluded": {

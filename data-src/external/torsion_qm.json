{
 "attribution": {
  "changes": "Relaxed torsion-drive energies were converted from hartree to kcal/mol relative to each scan's own minimum, and each scan was classified by the rotatable-bond type used by this tool. No energies were recomputed.",
  "dataset_licence": "CC-BY-4.0",
  "datasets_used": [
   "OpenFF Group1 Torsions",
   "OpenFF Substituted Phenyl Set 1",
   "OpenFF Substituted Phenyl Set 1 v2.0",
   "OpenFF WBO Conjugated Series v1.0"
  ],
  "licence_statement": "All datasets in this repository are licensed under the CC-BY-4.0 license. (openforcefield/qca-dataset-submission, LICENSE)",
  "licence_url": "https://github.com/openforcefield/qca-dataset-submission/blob/master/LICENSE",
  "server": "https://api.qcarchive.molssi.org",
  "server_licence_note": "The public QCArchive server itself states no site-wide data licence; only OpenFF-submitted datasets are used by default.",
  "source": "MolSSI QCArchive (public server)",
  "submitter": "Open Force Field Initiative"
 },
 "bin_width_deg": 15.0,
 "caveats": [
  "Relaxed gas-phase QM scans of isolated molecules. They give the INTRINSIC cost of a torsion, not what a bound conformation can afford: a protein may well pay 2 kcal/mol for a better contact.",
  "Each curve pools chemically related bonds, so substituents move individual cases away from the median. The interquartile range is reported for that reason.",
  "Energies are relative within a scan; they are not comparable between different molecules in absolute terms."
 ],
